# ─────────────────────────────────────────────────────────────────────────────
# Fireblocks NCW → Dynamic WaaS migration POC — frontend env
# Copy to `.env` and fill in. All client-exposed vars MUST be prefixed VITE_.
# Do NOT put secrets here — anything in a VITE_ var ships to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Auto-initialize the NCW SDK on load (true|false). Convenient for the demo.
VITE_AUTOMATE_INITIALIZATION=true

# Base URL of the ncw-backend-demo API (Express). Local dev default below.
VITE_BACKEND_BASE_URL=http://localhost:3000

# Fireblocks NCW SDK environment: "sandbox" | "production".
# Must match the workspace your backend API keys belong to.
VITE_NCW_SDK_ENV=sandbox

# Apple CloudKit — optional, used by the reference demo's iCloud key backup.
# Leave blank if you are not exercising the CloudKit backup path.
VITE_CLOUDKIT_APITOKEN=your-cloudkit-api-token
VITE_CLOUDKIT_CONTAINER_ID=iCloud.com.example.ncw.demo
VITE_CLOUDKIT_ENV=production

# Dynamic — environment ID from the Dynamic dashboard (Developers → SDK).
# The WaaS-enabled environment whose importPrivateKey the key migration targets.
VITE_DYNAMIC_ENVIRONMENT_ID=your-dynamic-environment-id
